{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "External taxonomy structure",
  "type": "object",
  "required": ["version", "categories", "priorities", "needs_human_always"],
  "properties": {
    "version": {"type": "string", "minLength": 1},
    "note": {"type": "string"},
    "categories": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["code", "kind", "title", "rules", "examples"],
        "properties": {
          "code": {"type": "string", "pattern": "^(complaint|report)\\.[a-z_]+$"},
          "kind": {"enum": ["complaint", "report"]},
          "title": {"type": "string", "minLength": 1},
          "rules": {"type": "array", "items": {"type": "string"}},
          "examples": {"type": "array", "items": {"type": "string"}}
        }, "additionalProperties": false
      }
    },
    "priorities": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "items": {
        "type": "object", "required": ["code", "title", "rule"],
        "properties": {
          "code": {"enum": ["p0", "p1", "p2", "p3"]},
          "title": {"type": "string"}, "rule": {"type": "string"}
        }, "additionalProperties": false
      }
    },
    "needs_human_always": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
  },
  "additionalProperties": false
}
